# MongoDB local Docker container credentials
MONGO_USER=biotope_admin
MONGO_PASSWORD=your_strong_password_here

# Connection URI — hostname "mongo" is the Docker Compose service name
MONGODB_URI=mongodb://biotope_admin:your_strong_password_here@mongo:27017/biotope_db?authSource=admin

# Database name
MONGODB_DB=biotope_db

# Admin password gating every /api/admin/* endpoint (ADR-0035).
# Use >=16 random characters; required for the config-deletion admin page.
# Sent by the admin page as the X-Admin-Key header; never commit a real value.
ADMIN_PASSWORD=
