{
  "_meta": {
    "description": "Per-country reference attributes for ESC participants, keyed by ISO2 (joins entries.json.country_iso2). Static attributes are scalars/lists; time-varying attributes are lists of intervals with explicit from/to (to: null = open/ongoing). Stored at full-year resolution; decade aggregation happens in code. Prose, rationale and the controlled vocabularies live in knowledge/09-laender-attribute.md.",
    "join_key": "country_iso2 (ISO2)",
    "vocab": "eurovision-data/README.md (section: country_attributes.json)",
    "status": "wars[] filled for all 52 ESC codes; languages/cultural_region/government still scaffold (only DE, SE, UA, YU complete)",
    "wars_scope": {
      "definition": "Only conflicts in which the country itself is a direct belligerent: interstate wars, territorial wars, and full-scale civil/disintegration wars. Excludes coalition/expeditionary interventions abroad (e.g. Iraq 2003, Afghanistan, Libya 2011, Russia in Syria) and low-intensity internal insurgencies/terror campaigns (PKK, ETA, Northern Ireland Troubles, North Macedonia 2001, Albania 1997 unrest).",
      "window": "Wars whose dates overlap the ESC era 1956-2026 (a war is recorded even if the country joined the ESC later, as long as the war years fall in range).",
      "role_vocab": {
        "verteidigend": "country defends against an attack/invasion on its own (claimed) territory",
        "angreifend": "country launched the offensive / invaded or attacked another territory",
        "zwischenstaatlich": "mutual interstate war with symmetric or disputed initiation",
        "buergerkrieg": "internal civil war on the country's own territory",
        "zerfallskonflikt": "war of state disintegration / post-imperial separatism",
        "kolonialkrieg": "metropole fighting an independence/decolonisation movement"
      },
      "notes": "role reflects the state's primary military posture and is a simplification of contested histories. The same war appears under each belligerent ESC country with a mirrored role (e.g. Cyprus 1974: CY verteidigend / TR angreifend). Successor-state attribution follows the dataset's historical codes: SFRY breakup wars (1991-1995) sit on YU; the Kosovo War (1998-1999) on RS as the enduring Serbian code.",
      "sources": "Verified June 2026 against Wikipedia conflict articles (en.wikipedia.org) cross-checked with Britannica/ICTY/CFR; dates at full-year resolution."
    }
  },
